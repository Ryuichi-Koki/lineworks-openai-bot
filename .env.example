OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 顧問先が利用するLINE公式アカウント（Messaging API）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 職員が承認するLINE WORKS Bot
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LINEWORKS_BOT_ID=
LINEWORKS_BOT_SECRET=
LINEWORKS_STAFF_CHANNEL_ID=

# 任意: 承認を許可するLINE WORKS userId（カンマ区切り）
LINEWORKS_APPROVER_USER_IDS=

# 本番必須。未設定時はローカルのプロセスメモリに保存されます。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APPROVAL_TTL_SECONDS=1209600

# 同じ顧問先との会話履歴。既定は直近20メッセージ、最終更新から30日です。
CONVERSATION_HISTORY_MAX_MESSAGES=20
CONVERSATION_HISTORY_TTL_SECONDS=2592000
