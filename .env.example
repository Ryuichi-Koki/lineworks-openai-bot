OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 公式ドメイン制限付きWeb検索専用モデル。既定はgpt-5-mini。
OPENAI_TAX_SEARCH_MODEL=gpt-5-mini
TAX_WEB_SEARCH_ENABLED=true
# 任意。未設定時はプロンプト内容のSHA-256から自動生成します。
TAX_PROMPT_VERSION=

# 顧問先が利用するLINE公式アカウント（Messaging API）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# リッチメニューを設定する対象アカウントのBasic ID（例: @123abcde）。
# アクセストークンの対象と一致しない場合、設定スクリプトは停止します。
LINE_RICH_MENU_EXPECTED_BASIC_ID=
# true: AIが一次回答をLINEへ即時送信し、必要案件だけ有料の税理士確認へ案内
# false/未設定: 従来どおり全件をLINE WORKSで承認後に送信
LINE_HYBRID_AUTO_REPLY_ENABLED=true

# 職員が承認するLINE WORKS Bot
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LINEWORKS_BOT_ID=
LINEWORKS_BOT_SECRET=
LINEWORKS_STAFF_CHANNEL_ID=

# 任意: 承認を許可するLINE WORKS userId（カンマ区切り）
LINEWORKS_APPROVER_USER_IDS=

# 本番必須。未設定時はローカルのプロセスメモリに保存されます。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APPROVAL_TTL_SECONDS=1209600

# 同じ顧問先との会話履歴。既定は直近20メッセージ、最終更新から30日です。
CONVERSATION_HISTORY_MAX_MESSAGES=20
CONVERSATION_HISTORY_TTL_SECONDS=2592000

# LINE公式アカウント メンバーシップ／利用回数管理。
# DBマイグレーションとテスト完了後に限りtrueにしてください。
MEMBERSHIP_BILLING_ENABLED=false
LINE_MEMBERSHIP_ANSHIN_ID=
# 将来の上位プラン用。公開までは空欄で構いません。
LINE_MEMBERSHIP_PREMIUM_ID=
# LINE Official Account Managerで取得した加入ページURL
LINE_MEMBERSHIP_JOIN_URL=

# Supabase/PostgreSQL（サーバー専用接続文字列）
DATABASE_URL=
DATABASE_SSL_MODE=require

# /admin/members の管理者認証
ADMIN_DASHBOARD_USER=
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe (test mode only; never commit actual values)
STRIPE_BILLING_ENABLED=false
STRIPE_MODE=test
# live切替時の二重確認。ライブ用キー登録だけでは課金を開始できません。
STRIPE_LIVE_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANSHIN=
STRIPE_PRICE_PREMIUM=
# 任意。未設定時はStripeアカウントの既定Customer Portal設定を使用します。
# ライブ移行時は専用設定を作成し、明示的なIDを登録してください。
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_APP_BASE_URL=http://localhost:3000

# 規程ページと同意記録
LEGAL_APP_BASE_URL=http://localhost:3000
# 2026年7月24日版。公開承認までは同意取得を有効化しない
LEGAL_POLICY_VERSION=2026-07-24-v1
# 本文公開・DB migration・導線確認の完了後だけ true にする
LEGAL_CONSENT_REQUIRED=false

# 顧問先プロファイルはRedisの apexbrain:line-client:<LINE userIdのSHA-256先頭32桁>
# にJSONで保存します。記録のある項目だけが回答生成時に参照されます。
